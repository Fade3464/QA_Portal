# Local defaults. Replace every secret before exposing the portal publicly.
PRODUCTION=false
# Development-only switches. PRODUCTION=true forces DEBUG off and HTTPS
# redirects on regardless of these copied local values.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
SECURE_SSL_REDIRECT=false
TIME_ZONE=America/New_York
FRONTEND_URL=http://localhost:8080
PORTAL_PORT=8080

POSTGRES_DB=qa_portal
POSTGRES_USER=qa_portal
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Runtime web/worker traffic uses transaction pooling. Migrations bypass it.
DB_USE_PGBOUNCER=true
# One database/user pool: 20 normal + 5 reserve PostgreSQL connections.
PGBOUNCER_POOL_SIZE=20
PGBOUNCER_RESERVE_POOL_SIZE=5
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_QUERY_WAIT_TIMEOUT=30

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DIALER_CREDENTIAL_KEY=

# Created only on first boot. Change/remove ADMIN_PASSWORD after signing in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# Password-reset mail transport only; notification mailing is not configured.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=QA Portal <noreply@example.com>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=20
LOG_LEVEL=INFO
# SQL execution telemetry: 48h minute detail / 90d hourly history in cache Redis.
DB_METRICS_ENABLED=true
DB_METRICS_SLOW_MS=100
# Optional override; Docker uses CACHE_URL (Redis DB 2) by default.
DB_METRICS_REDIS_URL=
RECORDING_RETRY_DELAYS=5,15,30,60,120
RECORDING_MAX_BYTES=262144000
# Keep true unless a trusted dialer returns allowlisted HTTPS IP URLs whose
# certificates cannot be validated by hostname.
RECORDING_DOWNLOAD_VERIFY_TLS=false
