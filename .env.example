# Local defaults. Replace every secret before exposing the portal publicly.
PRODUCTION=false
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
SECURE_SSL_REDIRECT=false
TIME_ZONE=Asia/Karachi
FRONTEND_URL=http://localhost:8080
PORTAL_PORT=8080

POSTGRES_DB=qa_portal
POSTGRES_USER=qa_portal
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DIALER_CREDENTIAL_KEY=

# Created only on first boot. Change/remove ADMIN_PASSWORD after signing in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=QA Portal <noreply@example.com>
LOG_LEVEL=INFO
RECORDING_RETRY_DELAYS=5,15,30,60,120
RECORDING_MAX_BYTES=262144000
# Keep true unless a trusted dialer returns allowlisted HTTPS IP URLs whose
# certificates cannot be validated by hostname.
RECORDING_DOWNLOAD_VERIFY_TLS=false
